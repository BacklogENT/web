PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=redeban_backlog

# Generate a unique random value of at least 32 characters. Never reuse this example.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# Allowlist for administrator accounts; the account must also exist in MySQL.
ADMIN_EMAILS=

# SMTP is required for password-reset emails. Prefer an app password, never an account password.
APP_PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
